auto DrawOutlinedText = [&](ImVec2 pos, ImColor col, const char* text, float size = 22.0f) {
    draw->AddText(NULL, size, ImVec2(pos.x + 1, pos.y + 1), ImColor(0, 0, 0, 255), text);
    draw->AddText(NULL, size, ImVec2(pos.x - 1, pos.y - 1), ImColor(0, 0, 0, 255), text);
    draw->AddText(NULL, size, pos, col, text);};
