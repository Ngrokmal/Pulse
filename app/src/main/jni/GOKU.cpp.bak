            showWinPopup = true;  

        if (showWinPopup) {  
            static float popupAlpha = 0.0f;  
            static float shakeOffset = 0.0f;  
            static bool shakeDirection = true;  
            static float colorOffset = 0.0f;  
            static float textShakeOffset = 0.0f;  

            // Smooth fade-in
            if (popupAlpha < 1.0f) popupAlpha += 0.05f;  
            shakeDirection ? shakeOffset += 0.5f : shakeOffset -= 0.5f;  
            if (shakeOffset > 2.0f) shakeDirection = false;  
            if (shakeOffset < -2.0f) shakeDirection = true;  

            textShakeOffset = sin(ImGui::GetTime() * 10.0f) * 1.5f;  
            colorOffset += 0.05f;  

            float r = 0.5f + 0.5f * sin(colorOffset);  
            float g = 0.5f + 0.5f * sin(colorOffset + 2.0f);  
            float b = 0.5f + 0.5f * sin(colorOffset + 4.0f);  

            ImVec2 center = ImGui::GetMainViewport()->GetCenter();  
            center.x += shakeOffset;  
            center.y += shakeOffset;  

            ImGui::SetNextWindowPos(center, ImGuiCond_Appearing, ImVec2(0.5f, 0.5f));  
            ImGui::SetNextWindowBgAlpha(popupAlpha);  
            ImGui::OpenPopup("WinPopup");  

            if (ImGui::BeginPopupModal("WinPopup", nullptr,
                ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove))  
            {  
                // === Particle Background Inside Popup ===  
                const auto& pWindowDrawList = ImGui::GetWindowDrawList();  
                ImDrawList* pDrawList = pWindowDrawList;  
                static const int numParticles = 100;  
                static ImVec2 particlePositions[numParticles];  
                static ImVec2 particleVelocities[numParticles];  
                static bool initialized = false;  

                ImVec2 winPos = ImGui::GetWindowPos();  
                ImVec2 winSize = ImGui::GetWindowSize();  

                if (!initialized) {  
                    for (int i = 0; i < numParticles; ++i) {  
                        particlePositions[i] = ImVec2(  
                            winPos.x + winSize.x * static_cast<float>(rand()) / RAND_MAX,  
                            winPos.y + winSize.y * static_cast<float>(rand()) / RAND_MAX  
                        );  
                        particleVelocities[i] = ImVec2(  
                            static_cast<float>((rand() % 100) - 50),  
                            static_cast<float>((rand() % 100) - 50)  
                        );  
                    }  
                    initialized = true;  
                }  

                float deltaTime = ImGui::GetIO().DeltaTime;  
                for (int i = 0; i < numParticles; ++i) {  
                    particlePositions[i].x += particleVelocities[i].x * deltaTime;  
                    particlePositions[i].y += particleVelocities[i].y * deltaTime;  

                    // Boundaries inside popup window
                    if (particlePositions[i].x < winPos.x) particlePositions[i].x = winPos.x + winSize.x;  
                    else if (particlePositions[i].x > winPos.x + winSize.x) particlePositions[i].x = winPos.x;  

                    if (particlePositions[i].y < winPos.y) particlePositions[i].y = winPos.y + winSize.y;  
                    else if (particlePositions[i].y > winPos.y + winSize.y) particlePositions[i].y = winPos.y;  

                    // Color with light transparency
                    ImU32 particleColour = ImGui::GetColorU32(ImVec4(r, g, b, 0.4f));  
                    pDrawList->AddCircleFilled(particlePositions[i], 1.8f, particleColour);  
                }

// === Popup Text & Buttons ===  
                ImGui::Dummy(ImVec2(0.0f, 10.0f));  
                ImGui::SetCursorPosX(ImGui::GetWindowWidth() / 2 - ImGui::CalcTextSize("WINNER WINNER CHICKEN DINNER").x / 2 + textShakeOffset);  
                ImGui::TextColored(ImVec4(r, g, b, 1.0f), "WINNER WINNER CHICKEN DINNER");  

                ImGui::Separator();  
                ImGui::BulletText("RESTART YOUR GAME");  
                ImGui::Separator();  
                ImGui::BulletText("YOUR FEEDBACK IS IMPORTANT ");  
                ImGui::Separator();  
                ImGui::BulletText("TG OWNER :- @GOKU_CHEATSS");  
                ImGui::Spacing();  

                float buttonWidth = ImGui::GetWindowWidth() * 0.9f;  
                float buttonHeight = 45.0f;  
                ImGui::SetCursorPosX((ImGui::GetWindowWidth() - buttonWidth) / 2);  

                ImGui::PushStyleVar(ImGuiStyleVar_FrameBorderSize, 2.5f);  
                ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 10.0f);  
                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.25f, 0.25f, 0.25f, 1.0f));  
                ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.35f, 0.35f, 0.35f, 1.0f));  
                ImGui::PushStyleColor(ImGuiCol_ButtonActive, ImVec4(0.15f, 0.15f, 0.15f, 1.0f));  

                if (ImGui::Button("OK", ImVec2(buttonWidth, buttonHeight))) {  
                    popupAlpha = 0.0f;  
                    shakeOffset = 0.0f;  
                    colorOffset = 0.0f;  
                    textShakeOffset = 0.0f;  
                    showWinPopup = false;  
                    popupClosed = true;  
                    initialized = false; // reset particle system  
                    ImGui::CloseCurrentPopup();  
                }  

                ImGui::PopStyleColor(3);  
                ImGui::PopStyleVar(2);  
                ImGui::EndPopup();  
            }  
        }  
    }  
}
		  else if (isObjectPickUp(Actor)) {
int ZY13 = *(int *) (Actor + PickUpWrapperActor_DefineID + 0x4);
