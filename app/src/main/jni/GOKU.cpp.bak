void DrawEnemyCounterPanel(float glWidth,int totalEnemies,int totalBots);{
ImDrawList* dl=ImGui::GetForegroundDrawList();
float time=ImGui::GetTime();
ImFont* font=ImGui::GetFont();
float baseFont=ImGui::GetFontSize();
auto SilverShade=[&](float offset)->int{return(int)(180+50*(0.5f+0.5f*sinf(time*0.8f+offset)));};
ImU32 colorBlack=IM_COL32(15,15,15,220);
ImU32 colorSilverTL=IM_COL32(SilverShade(0.0f),SilverShade(1.0f),SilverShade(2.0f),220);
ImU32 colorSilverBR=IM_COL32(SilverShade(3.0f),SilverShade(4.0f),SilverShade(5.0f),180);
const float panelW=140.0f;
const float panelH=34.0f;
const float panelX=(glWidth/2.0f)-(panelW/2.0f);
const float panelY=36.0f;
const float panelRounding=8.0f;
dl->AddRectFilledMultiColor(ImVec2(panelX,panelY),ImVec2(panelX+panelW,panelY+panelH),colorBlack,colorSilverTL,colorBlack,colorSilverBR);
dl->AddRect(ImVec2(panelX-1.0f,panelY-1.0f),ImVec2(panelX+panelW+1.0f,panelY+panelH+1.0f),IM_COL32(255,255,255,200),panelRounding);
dl->AddRect(ImVec2(panelX-2.0f,panelY-2.0f),ImVec2(panelX+panelW+2.0f,panelY+panelH+2.0f),IM_COL32(255,255,255,90),panelRounding);
const float pad=5.0f;
const float innerX1=panelX+pad;
const float innerY1=panelY+pad;
const float innerX2=panelX+panelW-pad;
const float innerY2=panelY+panelH-pad;
dl->AddRectFilled(ImVec2(innerX1,innerY1),ImVec2(innerX2,innerY2),IM_COL32(0,0,0,160),panelRounding-2.0f);
if(totalEnemies+totalBots==0){
std::string safeText="SAFE";
float fontScale=1.6f;
float fontSize=baseFont*fontScale;
ImVec2 measured=ImGui::CalcTextSize(safeText.c_str(),nullptr,false);
ImVec2 textSize=ImVec2(measured.x*(fontSize/baseFont),measured.y*(fontSize/baseFont));
float tx=panelX+(panelW*0.5f)-(textSize.x*0.5f);
float ty=panelY+(panelH*0.5f)-(textSize.y*0.5f);
int r=(int)(127+128*sinf(time*2.0f+0.0f));
int g=(int)(127+128*sinf(time*2.0f+2.0f));
int b=(int)(127+128*sinf(time*2.0f+4.0f));
ImU32 rgbCol=IM_COL32(r,g,b,255);
float outlineOffset=1.2f;
dl->AddText(font,fontSize,ImVec2(tx-outlineOffset,ty),IM_COL32(0,0,0,255),safeText.c_str());
dl->AddText(font,fontSize,ImVec2(tx+outlineOffset,ty),IM_COL32(0,0,0,255),safeText.c_str());
dl->AddText(font,fontSize,ImVec2(tx,ty-outlineOffset),IM_COL32(0,0,0,255),safeText.c_str());
dl->AddText(font,fontSize,ImVec2(tx,ty+outlineOffset),IM_COL32(0,0,0,255),safeText.c_str());
dl->AddText(font,fontSize,ImVec2(tx,ty),rgbCol,safeText.c_str());
return;
}
const float squareSize=panelH-(2.0f*pad);
const float spacing=6.0f;
const float totalSquaresW=(squareSize*2.0f)+spacing;
const float startX=(glWidth/2.0f)-(totalSquaresW/2.0f);
const float sqY=innerY1;
ImU32 colorReal=IM_COL32(220,30,30,200);
ImU32 colorBot=IM_COL32(30,200,30,200);
ImU32 colorSquareBorder=IM_COL32(255,255,255,70);
ImVec2 realTL(startX,sqY);
ImVec2 realBR(startX+squareSize,sqY+squareSize);
dl->AddRectFilled(realTL,realBR,colorReal,6.0f);
dl->AddRect(realTL,realBR,colorSquareBorder,6.0f);
ImVec2 botTL(startX+squareSize+spacing,sqY);
ImVec2 botBR(startX+squareSize+spacing+squareSize,sqY+squareSize);
dl->AddRectFilled(botTL,botBR,colorBot,6.0f);
dl->AddRect(botTL,botBR,colorSquareBorder,6.0f);
std::string strReal=std::to_string(totalEnemies);
std::string strBot=std::to_string(totalBots);
auto DrawScaledTextCentered=[&](const std::string&s,ImVec2 tl,ImVec2 br,float scaleMultiplier){
float fSize=baseFont*scaleMultiplier;
ImVec2 measured=ImGui::CalcTextSize(s.c_str(),nullptr,false);
ImVec2 textSize=ImVec2(measured.x*(fSize/baseFont),measured.y*(fSize/baseFont));
ImVec2 center((tl.x+br.x)*0.5f,(tl.y+br.y)*0.5f);
float tx=center.x-(textSize.x*0.5f);
float ty=center.y-(textSize.y*0.5f);
dl->AddText(font,fSize,ImVec2(tx,ty-1.0f),IM_COL32(255,255,255,255),s.c_str());
};
DrawScaledTextCentered(strReal,realTL,realBR,1.2f);
DrawScaledTextCentered(strBot,botTL,botBR,1.2f);
std::string labelReal="真人";
std::string labelBot="人机";
float labelSize=baseFont*0.75f;
ImVec2 labelRealMeasured=ImGui::CalcTextSize(labelReal.c_str(),nullptr,false);
ImVec2 labelBotMeasured=ImGui::CalcTextSize(labelBot.c_str(),nullptr,false);
float labelY=panelY+panelH+2.0f;
dl->AddText(font,labelSize,ImVec2(realTL.x+(squareSize*0.5f)-(labelRealMeasured.x*(labelSize/baseFont)*0.5f),labelY),IM_COL32(200,200,200,200),labelReal.c_str());
dl->AddText(font,labelSize,ImVec2(botTL.x+(squareSize*0.5f)-(labelBotMeasured.x*(labelSize/baseFont)*0.5f),labelY),IM_COL32(200,200,200,200),labelBot.c_str());
}
}

